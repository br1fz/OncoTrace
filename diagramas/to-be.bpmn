<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_TOBE_HGF" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.0">
  <bpmn:collaboration id="Collaboration_TOBE">
    <bpmn:participant id="Pool_HGF_TB" name="Hospital Dr. Gustavo Fricke – Plataforma OncoTrace (TO-BE)" processRef="Process_HGF_TB" />
    <bpmn:participant id="Pool_HCVB_TB" name="Hospital Carlos Van Buren (Radioterapia / QT Tumores Sólidos)" />
    <bpmn:participant id="Pool_Privados_TB" name="Centros de Salud Privados / Clínicas (PET-CT, EBUS)" />
    <bpmn:messageFlow id="MF_TB_DerivacionHCVB" name="Dossier Digital y Derivación Externa (Macrored)" sourceRef="TB_Task_UGAA_Despachar" targetRef="Pool_HCVB_TB" />
    <bpmn:messageFlow id="MF_TB_CompraServ" name="Solicitud Compra de Servicio (PET-CT / EBUS)" sourceRef="TB_Task_CompraServicio" targetRef="Pool_Privados_TB" />
    <bpmn:messageFlow id="MF_TB_ResultadosExt" name="Recepción Informes Digitales Externos" sourceRef="Pool_Privados_TB" targetRef="TB_Task_RecibirResultExt" />
    <bpmn:messageFlow id="MF_TB_ContraRefHCVB" name="Epicrisis y Contrarreferencia desde HCVB" sourceRef="Pool_HCVB_TB" targetRef="TB_Task_RecibirContraRefExt" />
  </bpmn:collaboration>
  <bpmn:process id="Process_HGF_TB" name="Plataforma de Trazabilidad y Gestión Oncológica OncoTrace – HGF" isExecutable="false">
    <bpmn:laneSet id="LaneSet_TB">
      <bpmn:lane id="Lane_TB_Paciente" name="Paciente / Familia y Cuidador">
        <bpmn:flowNodeRef>TB_Start_ConsultaPresencial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_Task_PresentarseCAE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_Task_TomarMuestra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_Task_ListaEsperaQx</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_Task_PacienteTratamiento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_Task_UsaTotem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_End_Tratamiento</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TB_Medico" name="Médico Tratante / Especialista">
        <bpmn:flowNodeRef>TB_Start_Consulta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_Start_Comite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_Start_Traslado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_GW_Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_Task_EmitirOrden</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_Task_Cirugia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_Task_QTHemato</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_Task_Paliativos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_Task_ControlSeguimiento</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TB_Gestor" name="Gestor/a Oncológico/a (UGCO) – [TB-01] [TB-02] [TB-03]">
        <bpmn:flowNodeRef>TB_Task_IngresoOncoTrace</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_Task_EvaluacionMultidimensional</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_Task_BitacoraAcompanamiento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_Task_MonitoreoTablero</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_GW_Validacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_Task_CompraServicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_Task_RecibirResultExt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_Task_ProgramarComite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_Task_DerivarRehabilitacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_Task_RecibirContraRefExt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_Task_ContraRefCierre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_GW_TipoUrgencia</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TB_TENS" name="Técnico en Enfermería (TENS UGCO)">
        <bpmn:flowNodeRef>TB_Task_TENS_DossierDigital</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_Task_TENS_Contactabilidad</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TB_Admin" name="Administrativo/a UGCO">
        <bpmn:flowNodeRef>TB_Task_Admin_Citas</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TB_UGAA" name="UGAA (Gestión de Atención Abierta) – [TB-08]">
        <bpmn:flowNodeRef>TB_Task_UGAA_Despachar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TB_GES" name="Unidad GES y Registros">
        <bpmn:flowNodeRef>TB_Task_GES_Validar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TB_Comite" name="Comité Oncológico Multidisciplinario – [TB-07]">
        <bpmn:flowNodeRef>TB_Task_ComiteDigital</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_GW_Tratamiento</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TB_Sistema" name="Sistema OncoTrace (Motor Central Automático) – [TB-04] [TB-05] [TB-06] [TB-10]">
        <bpmn:flowNodeRef>TB_Task_ConsolidacionAuto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_Task_MotorAlertasGES</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_Task_SincronizacionMINSAL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_Task_GenerarFichaComite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_Task_AsistenteVirtualTriage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_End_TicketEmitido</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- ═══════════════════════════════════════════════════════════
         FLUJO PRINCIPAL: INGRESO DE PACIENTE ONCOLÓGICO
         ═══════════════════════════════════════════════════════════ -->
    <bpmn:startEvent id="TB_Start_Consulta" name="Sospecha Clínica en Consulta">
      <bpmn:outgoing>TB_Flow_01a</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="TB_Start_Comite" name="Ingreso Directo a Comité">
      <bpmn:outgoing>TB_Flow_01b</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="TB_Start_Traslado" name="Traslado Extra-red / APS">
      <bpmn:outgoing>TB_Flow_01c</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="TB_GW_Inicio" name="Punto de Entrada al Proceso">
      <bpmn:incoming>TB_Flow_01a</bpmn:incoming>
      <bpmn:incoming>TB_Flow_01b</bpmn:incoming>
      <bpmn:incoming>TB_Flow_01c</bpmn:incoming>
      <bpmn:outgoing>TB_Flow_02</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="TB_Task_EmitirOrden" name="Médico emite orden de exámenes y solicitud de ingreso">
      <bpmn:incoming>TB_Flow_02</bpmn:incoming>
      <bpmn:outgoing>TB_Flow_03</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Etapa 1: Sospecha / Ingreso → Registro en OncoTrace -->
    <bpmn:userTask id="TB_Task_IngresoOncoTrace" name="[TB-01] Gestora registra paciente en OncoTrace y activa Tablero Kanban y Timeline Clínico">
      <bpmn:incoming>TB_Flow_03</bpmn:incoming>
      <bpmn:outgoing>TB_Flow_04</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Etapa 1→2: Evaluación Multidimensional -->
    <bpmn:userTask id="TB_Task_EvaluacionMultidimensional" name="[TB-02] Gestora realiza Evaluación Multidimensional Estandarizada (ECOG, Psicosocial, Cuidador, Espiritual)">
      <bpmn:incoming>TB_Flow_04</bpmn:incoming>
      <bpmn:outgoing>TB_Flow_05</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Bitácora primer contacto -->
    <bpmn:userTask id="TB_Task_BitacoraAcompanamiento" name="[TB-03] Gestora registra primer contacto en Bitácora Digital de Acompañamiento (PC-1)">
      <bpmn:incoming>TB_Flow_05</bpmn:incoming>
      <bpmn:outgoing>TB_Flow_06</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Administrativo agenda exámenes -->
    <bpmn:userTask id="TB_Task_Admin_Citas" name="Administrativo/a coordina y agenda horas de toma de muestras y exámenes">
      <bpmn:incoming>TB_Flow_06</bpmn:incoming>
      <bpmn:outgoing>TB_Flow_07</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Etapa 3: Etapificación → Exámenes -->
    <bpmn:userTask id="TB_Task_PresentarseCAE" name="Paciente asiste a toma de muestras y estudios diagnósticos">
      <bpmn:incoming>TB_Flow_07</bpmn:incoming>
      <bpmn:outgoing>TB_Flow_08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="TB_Task_TomarMuestra" name="Ejecución de Biopsia, TAC, RNM o Exámenes LIS">
      <bpmn:incoming>TB_Flow_08</bpmn:incoming>
      <bpmn:outgoing>TB_Flow_09</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- TB-05: Consolidación Automática -->
    <bpmn:serviceTask id="TB_Task_ConsolidacionAuto" name="[TB-05] OncoTrace consolida e indexa informes de patología e imágenes (LIS/PACS – HL7 FHIR) y emite alertas críticas">
      <bpmn:incoming>TB_Flow_09</bpmn:incoming>
      <bpmn:incoming>TB_Flow_CompraRetorno</bpmn:incoming>
      <bpmn:outgoing>TB_Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- TB-04: Motor Alertas GES -->
    <bpmn:serviceTask id="TB_Task_MotorAlertasGES" name="[TB-04] Motor de Alertas Preventivas GES e Inactividad evalúa plazos DS N° 29 (≤5 días hábiles / >15 días)">
      <bpmn:incoming>TB_Flow_10</bpmn:incoming>
      <bpmn:outgoing>TB_Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Unidad GES valida constancias y atiende tickets -->
    <bpmn:userTask id="TB_Task_GES_Validar" name="Gestora atiende ticket priorizado y / o valida constancia de garantías GES en OncoTrace">
      <bpmn:incoming>TB_Flow_11</bpmn:incoming>
      <bpmn:incoming>TB_Flow_TicketToGestor</bpmn:incoming>
      <bpmn:outgoing>TB_Flow_12</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Sincronización MINSAL (RNF-04 - ya no es TB numerado) -->
    <bpmn:serviceTask id="TB_Task_SincronizacionMINSAL" name="Sincronización bidireccional con Plataforma MINSAL (RNF-04 – Interoperabilidad Hospitalaria)">
      <bpmn:incoming>TB_Flow_12</bpmn:incoming>
      <bpmn:outgoing>TB_Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- TB-01: Monitoreo Tablero Kanban -->
    <bpmn:userTask id="TB_Task_MonitoreoTablero" name="[TB-01] Gestora monitorea Tablero Kanban y Timeline Clínico con resultados consolidados">
      <bpmn:incoming>TB_Flow_13</bpmn:incoming>
      <bpmn:outgoing>TB_Flow_14</bpmn:outgoing>
    </bpmn:userTask>

    <!-- ¿Exámenes completos para Comité? -->
    <bpmn:exclusiveGateway id="TB_GW_Validacion" name="¿Exámenes completos para Comité?">
      <bpmn:incoming>TB_Flow_14</bpmn:incoming>
      <bpmn:outgoing>TB_Flow_Completo</bpmn:outgoing>
      <bpmn:outgoing>TB_Flow_RequiereExt</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Rama Compra de Servicio Externo -->
    <bpmn:userTask id="TB_Task_CompraServicio" name="Gestora gestiona compra de servicio externo (PET-CT / EBUS)">
      <bpmn:incoming>TB_Flow_RequiereExt</bpmn:incoming>
      <bpmn:outgoing>TB_Flow_EsperaExt</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="TB_Task_RecibirResultExt" name="Gestora registra y adjunta resultado externo en OncoTrace">
      <bpmn:incoming>TB_Flow_EsperaExt</bpmn:incoming>
      <bpmn:outgoing>TB_Flow_CompraRetorno</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Etapa 4: En Comité → TB-06 Generar Ficha -->
    <bpmn:serviceTask id="TB_Task_GenerarFichaComite" name="[TB-06] OncoTrace genera automáticamente Ficha de Presentación a Comité (antecedentes, ECOG, biopsias, imágenes)">
      <bpmn:incoming>TB_Flow_Completo</bpmn:incoming>
      <bpmn:outgoing>TB_Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="TB_Task_ProgramarComite" name="Gestora agenda paciente en tabla de Comité Oncológico (PC-2 Bitácora)">
      <bpmn:incoming>TB_Flow_15</bpmn:incoming>
      <bpmn:outgoing>TB_Flow_16</bpmn:outgoing>
    </bpmn:userTask>

    <!-- TB-07: Acta Digital de Comité -->
    <bpmn:userTask id="TB_Task_ComiteDigital" name="[TB-07] Comité evalúa caso, registra conducta terapéutica TNM y firma Acta Digital con generación automática REM 0.7">
      <bpmn:incoming>TB_Flow_16</bpmn:incoming>
      <bpmn:outgoing>TB_Flow_17</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Compuerta de resolución terapéutica -->
    <bpmn:exclusiveGateway id="TB_GW_Tratamiento" name="Resolución Terapéutica del Comité">
      <bpmn:incoming>TB_Flow_17</bpmn:incoming>
      <bpmn:outgoing>TB_Flow_Cirugia</bpmn:outgoing>
      <bpmn:outgoing>TB_Flow_QTHemato</bpmn:outgoing>
      <bpmn:outgoing>TB_Flow_DerivExterna</bpmn:outgoing>
      <bpmn:outgoing>TB_Flow_Paliativos</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Etapa 5: Tratamiento Interno HGF -->
    <bpmn:userTask id="TB_Task_Cirugia" name="Cirugía Oncológica (Ingreso a Lista de Espera Qx HGF)">
      <bpmn:incoming>TB_Flow_Cirugia</bpmn:incoming>
      <bpmn:outgoing>TB_Flow_QxEsp</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="TB_Task_ListaEsperaQx" name="Paciente en Lista de Espera Quirúrgica y Pabellón">
      <bpmn:incoming>TB_Flow_QxEsp</bpmn:incoming>
      <bpmn:outgoing>TB_Flow_FinQx</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="TB_Task_QTHemato" name="Quimioterapia Hematológica en HGF">
      <bpmn:incoming>TB_Flow_QTHemato</bpmn:incoming>
      <bpmn:outgoing>TB_Flow_FinQTHem</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="TB_Task_Paliativos" name="Ingreso a Unidad de Cuidados Paliativos y Alivio del Dolor">
      <bpmn:incoming>TB_Flow_Paliativos</bpmn:incoming>
      <bpmn:outgoing>TB_Flow_FinPal</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="TB_Task_PacienteTratamiento" name="Paciente recibe Tratamiento en HGF con Acompañamiento Continuo OncoTrace (PC-3 Bitácora)">
      <bpmn:incoming>TB_Flow_FinQx</bpmn:incoming>
      <bpmn:incoming>TB_Flow_FinQTHem</bpmn:incoming>
      <bpmn:incoming>TB_Flow_FinPal</bpmn:incoming>
      <bpmn:outgoing>TB_Flow_TratToRehab</bpmn:outgoing>
    </bpmn:manualTask>

    <!-- Etapa 6: Rehabilitación -->
    <bpmn:userTask id="TB_Task_DerivarRehabilitacion" name="[TB-03] Gestora deriva a Equipo Multidisciplinario (Psicosocial, Nutrición, Kinesiología, Fonoaudiología) y registra en Bitácora (PC-4)">
      <bpmn:incoming>TB_Flow_TratToRehab</bpmn:incoming>
      <bpmn:outgoing>TB_Flow_RehabToSeguimiento</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Etapa 7: Seguimiento Activo -->
    <bpmn:userTask id="TB_Task_ControlSeguimiento" name="Médico realiza controles periódicos de vigilancia post-tratamiento (Sobrevivientes)">
      <bpmn:incoming>TB_Flow_RehabToSeguimiento</bpmn:incoming>
      <bpmn:incoming>TB_Flow_ContraRefToSeguimiento</bpmn:incoming>
      <bpmn:outgoing>TB_Flow_SeguimientoToTENS</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="TB_Task_TENS_Contactabilidad" name="[TB-03] TENS realiza contactabilidad activa periódica y registra 6to Punto de Contacto Obligatorio en Bitácora (PC-5 / PC-6)">
      <bpmn:incoming>TB_Flow_SeguimientoToTENS</bpmn:incoming>
      <bpmn:outgoing>TB_Flow_SeguimientoToContraRef</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Etapa 8: Alta y Contrarreferencia / Cierre -->
    <bpmn:userTask id="TB_Task_ContraRefCierre" name="[TB-01] Gestora coordina Contrarreferencia a APS y registra Cierre de Caso en Tablero OncoTrace">
      <bpmn:incoming>TB_Flow_SeguimientoToContraRef</bpmn:incoming>
      <bpmn:outgoing>TB_Flow_ContraRefToEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="TB_End_Tratamiento" name="Caso Cerrado: Tratamiento Completado, Trazabilidad Integral Registrada en OncoTrace">
      <bpmn:incoming>TB_Flow_ContraRefToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ═══════════════════════════════════════════════════════════
         FLUJO DERIVACIÓN EXTERNA – TB-08 (HCVB)
         ═══════════════════════════════════════════════════════════ -->
    <bpmn:userTask id="TB_Task_TENS_DossierDigital" name="[TB-08] TENS confecciona Dossier Digital de Derivación con expediente oncológico completo">
      <bpmn:incoming>TB_Flow_DerivExterna</bpmn:incoming>
      <bpmn:outgoing>TB_Flow_DossierToUGAA</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="TB_Task_UGAA_Despachar" name="[TB-08] UGAA valida, despacha y trackea derivación en macrored (HCVB) con alertas de rezago">
      <bpmn:incoming>TB_Flow_DossierToUGAA</bpmn:incoming>
      <bpmn:outgoing>TB_Flow_UGAAToEsperaRetorno</bpmn:outgoing>
    </bpmn:userTask>
    <!-- Recepción de Contrarreferencia desde HCVB → reingresa al flujo de Seguimiento -->
    <bpmn:userTask id="TB_Task_RecibirContraRefExt" name="[TB-08] Gestora recibe Epicrisis y Contrarreferencia desde HCVB y registra en OncoTrace (PC-5 Bitácora)">
      <bpmn:incoming>TB_Flow_UGAAToEsperaRetorno</bpmn:incoming>
      <bpmn:outgoing>TB_Flow_ContraRefToSeguimiento</bpmn:outgoing>
    </bpmn:userTask>

    <!-- ═══════════════════════════════════════════════════════════
         FLUJO PARALELO: AS-06 → TB-09 Tótem + TB-10 Asistente Virtual
         ═══════════════════════════════════════════════════════════ -->
    <bpmn:startEvent id="TB_Start_ConsultaPresencial" name="Paciente / Cuidador llega de forma espontánea a sala de espera UGCO (Ley N° 21.258)">
      <bpmn:outgoing>TB_Flow_DemandaEspontanea</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="TB_Task_UsaTotem" name="[TB-09] Paciente usa Tótem de Autoatención: consulta estado de trámites y exámenes mediante lectura de RUN / Cédula (Ley N° 20.584)">
      <bpmn:incoming>TB_Flow_DemandaEspontanea</bpmn:incoming>
      <bpmn:outgoing>TB_Flow_TotemEvalua</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="TB_GW_TipoUrgencia" name="¿Requiere atención presencial con Gestora?">
      <bpmn:incoming>TB_Flow_TotemEvalua</bpmn:incoming>
      <bpmn:outgoing>TB_Flow_SoloInfo</bpmn:outgoing>
      <bpmn:outgoing>TB_Flow_RequiereAtencion</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <!-- Rama: Solo requiere información (tótem resolvió la consulta) -->
    <bpmn:endEvent id="TB_End_TicketEmitido" name="Consulta Resuelta por Tótem / Asistente Virtual – Sin Interrupción a Gestora">
      <bpmn:incoming>TB_Flow_SoloInfo</bpmn:incoming>
    </bpmn:endEvent>
    <!-- Rama: Requiere atención → Asistente Virtual clasifica urgencia y emite ticket -->
    <bpmn:serviceTask id="TB_Task_AsistenteVirtualTriage" name="[TB-10] Asistente Virtual OncoTrace orienta derechos Ley N° 21.258 y emite ticket de triage priorizado (Alta / Media / Administrativa)">
      <bpmn:incoming>TB_Flow_RequiereAtencion</bpmn:incoming>
      <bpmn:outgoing>TB_Flow_TicketToGestor</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- ═══════════════════════════════════════════════════════════
         SEQUENCE FLOWS
         ═══════════════════════════════════════════════════════════ -->
    <bpmn:sequenceFlow id="TB_Flow_01a" sourceRef="TB_Start_Consulta" targetRef="TB_GW_Inicio" />
    <bpmn:sequenceFlow id="TB_Flow_01b" sourceRef="TB_Start_Comite" targetRef="TB_GW_Inicio" />
    <bpmn:sequenceFlow id="TB_Flow_01c" sourceRef="TB_Start_Traslado" targetRef="TB_GW_Inicio" />
    <bpmn:sequenceFlow id="TB_Flow_02" sourceRef="TB_GW_Inicio" targetRef="TB_Task_EmitirOrden" />
    <bpmn:sequenceFlow id="TB_Flow_03" sourceRef="TB_Task_EmitirOrden" targetRef="TB_Task_IngresoOncoTrace" />
    <bpmn:sequenceFlow id="TB_Flow_04" sourceRef="TB_Task_IngresoOncoTrace" targetRef="TB_Task_EvaluacionMultidimensional" />
    <bpmn:sequenceFlow id="TB_Flow_05" sourceRef="TB_Task_EvaluacionMultidimensional" targetRef="TB_Task_BitacoraAcompanamiento" />
    <bpmn:sequenceFlow id="TB_Flow_06" sourceRef="TB_Task_BitacoraAcompanamiento" targetRef="TB_Task_Admin_Citas" />
    <bpmn:sequenceFlow id="TB_Flow_07" sourceRef="TB_Task_Admin_Citas" targetRef="TB_Task_PresentarseCAE" />
    <bpmn:sequenceFlow id="TB_Flow_08" sourceRef="TB_Task_PresentarseCAE" targetRef="TB_Task_TomarMuestra" />
    <bpmn:sequenceFlow id="TB_Flow_09" sourceRef="TB_Task_TomarMuestra" targetRef="TB_Task_ConsolidacionAuto" />
    <bpmn:sequenceFlow id="TB_Flow_10" sourceRef="TB_Task_ConsolidacionAuto" targetRef="TB_Task_MotorAlertasGES" />
    <bpmn:sequenceFlow id="TB_Flow_11" sourceRef="TB_Task_MotorAlertasGES" targetRef="TB_Task_GES_Validar" />
    <bpmn:sequenceFlow id="TB_Flow_12" sourceRef="TB_Task_GES_Validar" targetRef="TB_Task_SincronizacionMINSAL" />
    <bpmn:sequenceFlow id="TB_Flow_13" sourceRef="TB_Task_SincronizacionMINSAL" targetRef="TB_Task_MonitoreoTablero" />
    <bpmn:sequenceFlow id="TB_Flow_14" sourceRef="TB_Task_MonitoreoTablero" targetRef="TB_GW_Validacion" />
    <bpmn:sequenceFlow id="TB_Flow_Completo" name="Sí (Completos)" sourceRef="TB_GW_Validacion" targetRef="TB_Task_GenerarFichaComite" />
    <bpmn:sequenceFlow id="TB_Flow_RequiereExt" name="Requiere PET-CT / EBUS" sourceRef="TB_GW_Validacion" targetRef="TB_Task_CompraServicio" />
    <bpmn:sequenceFlow id="TB_Flow_EsperaExt" sourceRef="TB_Task_CompraServicio" targetRef="TB_Task_RecibirResultExt" />
    <bpmn:sequenceFlow id="TB_Flow_CompraRetorno" sourceRef="TB_Task_RecibirResultExt" targetRef="TB_Task_ConsolidacionAuto" />
    <bpmn:sequenceFlow id="TB_Flow_15" sourceRef="TB_Task_GenerarFichaComite" targetRef="TB_Task_ProgramarComite" />
    <bpmn:sequenceFlow id="TB_Flow_16" sourceRef="TB_Task_ProgramarComite" targetRef="TB_Task_ComiteDigital" />
    <bpmn:sequenceFlow id="TB_Flow_17" sourceRef="TB_Task_ComiteDigital" targetRef="TB_GW_Tratamiento" />
    <bpmn:sequenceFlow id="TB_Flow_Cirugia" name="Cirugía" sourceRef="TB_GW_Tratamiento" targetRef="TB_Task_Cirugia" />
    <bpmn:sequenceFlow id="TB_Flow_QTHemato" name="QT Hemato" sourceRef="TB_GW_Tratamiento" targetRef="TB_Task_QTHemato" />
    <bpmn:sequenceFlow id="TB_Flow_DerivExterna" name="Derivación Externa (QT Sólida / RT)" sourceRef="TB_GW_Tratamiento" targetRef="TB_Task_TENS_DossierDigital" />
    <bpmn:sequenceFlow id="TB_Flow_Paliativos" name="Paliativos" sourceRef="TB_GW_Tratamiento" targetRef="TB_Task_Paliativos" />
    <bpmn:sequenceFlow id="TB_Flow_QxEsp" sourceRef="TB_Task_Cirugia" targetRef="TB_Task_ListaEsperaQx" />
    <bpmn:sequenceFlow id="TB_Flow_FinQx" sourceRef="TB_Task_ListaEsperaQx" targetRef="TB_Task_PacienteTratamiento" />
    <bpmn:sequenceFlow id="TB_Flow_FinQTHem" sourceRef="TB_Task_QTHemato" targetRef="TB_Task_PacienteTratamiento" />
    <bpmn:sequenceFlow id="TB_Flow_FinPal" sourceRef="TB_Task_Paliativos" targetRef="TB_Task_PacienteTratamiento" />
    <!-- Etapa 6: Tratamiento → Rehabilitación -->
    <bpmn:sequenceFlow id="TB_Flow_TratToRehab" sourceRef="TB_Task_PacienteTratamiento" targetRef="TB_Task_DerivarRehabilitacion" />
    <!-- Etapa 7: Rehabilitación → Seguimiento Médico -->
    <bpmn:sequenceFlow id="TB_Flow_RehabToSeguimiento" sourceRef="TB_Task_DerivarRehabilitacion" targetRef="TB_Task_ControlSeguimiento" />
    <!-- Seguimiento Médico → Contactabilidad TENS -->
    <bpmn:sequenceFlow id="TB_Flow_SeguimientoToTENS" sourceRef="TB_Task_ControlSeguimiento" targetRef="TB_Task_TENS_Contactabilidad" />
    <!-- TENS → Cierre de Caso -->
    <bpmn:sequenceFlow id="TB_Flow_SeguimientoToContraRef" sourceRef="TB_Task_TENS_Contactabilidad" targetRef="TB_Task_ContraRefCierre" />
    <!-- Etapa 8: Cierre → End -->
    <bpmn:sequenceFlow id="TB_Flow_ContraRefToEnd" sourceRef="TB_Task_ContraRefCierre" targetRef="TB_End_Tratamiento" />
    <!-- Derivación externa TB-08 -->
    <bpmn:sequenceFlow id="TB_Flow_DossierToUGAA" sourceRef="TB_Task_TENS_DossierDigital" targetRef="TB_Task_UGAA_Despachar" />
    <bpmn:sequenceFlow id="TB_Flow_UGAAToEsperaRetorno" sourceRef="TB_Task_UGAA_Despachar" targetRef="TB_Task_RecibirContraRefExt" />
    <!-- Retorno contrarreferencia externa → Etapa 7 Seguimiento (reintegración al flujo principal) -->
    <bpmn:sequenceFlow id="TB_Flow_ContraRefToSeguimiento" sourceRef="TB_Task_RecibirContraRefExt" targetRef="TB_Task_ControlSeguimiento" />
    <!-- AS-06 / TB-09 / TB-10 -->
    <bpmn:sequenceFlow id="TB_Flow_DemandaEspontanea" sourceRef="TB_Start_ConsultaPresencial" targetRef="TB_Task_UsaTotem" />
    <bpmn:sequenceFlow id="TB_Flow_TotemEvalua" sourceRef="TB_Task_UsaTotem" targetRef="TB_GW_TipoUrgencia" />
    <bpmn:sequenceFlow id="TB_Flow_SoloInfo" name="Consulta resuelta en Tótem" sourceRef="TB_GW_TipoUrgencia" targetRef="TB_End_TicketEmitido" />
    <bpmn:sequenceFlow id="TB_Flow_RequiereAtencion" name="Requiere atención humana" sourceRef="TB_GW_TipoUrgencia" targetRef="TB_Task_AsistenteVirtualTriage" />
    <bpmn:sequenceFlow id="TB_Flow_TicketToGestor" sourceRef="TB_Task_AsistenteVirtualTriage" targetRef="TB_Task_GES_Validar" />
  </bpmn:process>

