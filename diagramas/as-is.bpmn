<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ASIS_UGCO" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.0">
  <bpmn:collaboration id="Collab_ASIS">
    <bpmn:participant id="Pool_HGF" name="Hospital Dr. Gustavo Fricke – Gestión Oncológica (AS-IS)" processRef="Proc_HGF" />
    <bpmn:participant id="Pool_Paciente" name="Paciente y Cuidador Principal" processRef="Proc_Paciente" />
    <bpmn:participant id="Pool_RedExterna" name="Red Externa / Hosp. Carlos Van Buren / Centros Privados" />
    <bpmn:messageFlow id="Msg_DossierToRed" name="Dossier físico de derivación" sourceRef="Task_UGAA_Derivar" targetRef="Pool_RedExterna" />
    <bpmn:messageFlow id="Msg_CompraServicio" name="Solicitud compra de servicio (PET-CT, EBUS, etc.)" sourceRef="Task_CompraServicio" targetRef="Pool_RedExterna" />
    <bpmn:messageFlow id="Msg_ResultadosExt" name="Resultados de exámenes externos" sourceRef="Pool_RedExterna" targetRef="Task_RecibirResultExt" />
    <bpmn:messageFlow id="Msg_ContraRef" name="Epicrisis / Contrarreferencia" sourceRef="Pool_RedExterna" targetRef="Task_RecibirContraRef" />
    <bpmn:messageFlow id="Msg_ContactoPaciente" name="Contacto inicial y orientación" sourceRef="Task_ContactoInicial" targetRef="Task_Pac_RecibeOrientacion" />
    <bpmn:messageFlow id="Msg_NotifExamen" name="Notificación fecha de examen" sourceRef="Task_Admin_NotifPaciente" targetRef="Task_Pac_RecibeNotif" />
    <bpmn:messageFlow id="Msg_InfoComite" name="Información resolución comité" sourceRef="Task_Gestor_InformaComite" targetRef="Task_Pac_RecibeInfoComite" />
    <bpmn:messageFlow id="Msg_PacAsiste" name="Paciente asiste a exámenes" sourceRef="Task_Pac_AsistExamen" targetRef="Task_Apoyo_TomarMuestra" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_HGF" name="Trayectoria Oncológica AS-IS – UGCO" isExecutable="false">
    <bpmn:laneSet id="LS_HGF">
      <bpmn:lane id="Lane_APS" name="Atención primaria y red asistencial">
        <bpmn:flowNodeRef>Start_DerivAPS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_DerivUrgencia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_DerivConsulta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_AltaAPS</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_UGDA" name="UGDA y lista de espera">
        <bpmn:flowNodeRef>GW_Ingreso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GestorCirugiaLEIQ</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Medico" name="Médico Tratante / Especialista">
        <bpmn:flowNodeRef>Task_MedEvalua</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MedEmiteOrdenes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Confirmacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MedConfirmaDiag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_PostConfirmacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MedEmiteIPD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MedComunicaDiag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MedPreparaComite</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Gestor" name="Gestor/a de casos UGCO">
        <bpmn:flowNodeRef>Task_AsignarGestor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ContactoInicial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValoracionDominios</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegistroPlataforma</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GestorSolicitaExam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ExamenTipo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompraServicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecibirResultExt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RescatarResultados</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ValoresCriticos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifCriticos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ConvExamenes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EntregaResultMedico</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GestorPreparaComite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Gestor_InformaComite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_TipoTratamiento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GestorQTHemato</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_DerivExterna</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecibirContraRef</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GestorDerivaPaliativos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_PostTratInterno</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DerivarMultidisc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_InicioSeguimiento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SeguimientoPeriodico</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_FinSeguimiento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_CierreCaso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ContraRefAPS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Fallecimiento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Traslado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TENS" name="TENS UGCO">
        <bpmn:flowNodeRef>Task_TENS_Dossier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TENS_Contactabilidad</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Admin" name="Administrativo/a UGCO">
        <bpmn:flowNodeRef>Task_Admin_RegistroIngreso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Admin_TramitaExam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Admin_NotifPaciente</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_UGAA" name="UGAA">
        <bpmn:flowNodeRef>Task_UGAA_Derivar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GES" name="Unidad GES y registros">
        <bpmn:flowNodeRef>Task_ConstanciaGES</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Comite" name="Comité Oncológico">
        <bpmn:flowNodeRef>Task_ComiteEvalua</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ComiteResolucion</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Apoyo" name="Unidades de Apoyo Diagnóstico">
        <bpmn:flowNodeRef>Start_InformeCritico</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Apoyo_TomarMuestra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Apoyo_ProcesarExam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Apoyo_EmitirInforme</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:dataObjectReference id="DataObj_FichaClinica" name="Ficha Clínica (Mixta)" dataObjectRef="DO_Ficha" />
    <bpmn:dataObject id="DO_Ficha" />
    <bpmn:dataObjectReference id="DataObj_PlataformaLocal" name="Plataforma de Registro Local (No interopera con MINSAL)" dataObjectRef="DO_Plataforma" />
    <bpmn:dataObject id="DO_Plataforma" />
    <bpmn:dataObjectReference id="DataObj_Dossier" name="Dossier Físico de Derivación" dataObjectRef="DO_Dossier" />
    <bpmn:dataObject id="DO_Dossier" />
    <bpmn:dataObjectReference id="DataObj_ActaComite" name="Acta de Comité / REM 0.7" dataObjectRef="DO_Acta" />
    <bpmn:dataObject id="DO_Acta" />
    <bpmn:dataObjectReference id="DataObj_ConstanciaGES" name="Constancia GES / IPD" dataObjectRef="DO_GES" />
    <bpmn:dataObject id="DO_GES" />
    <bpmn:startEvent id="Start_DerivAPS" name="Derivación desde APS (interconsulta)">
      <bpmn:outgoing>Flow_APS</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_DerivUrgencia" name="Derivación desde Urgencia Hospitalaria">
      <bpmn:outgoing>Flow_Urgencia</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_InformeCritico" name="Informe crítico de Anatomía Patológica">
      <bpmn:outgoing>Flow_InfCritico</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_InfCritico" />
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_DerivConsulta" name="Derivación desde consulta de especialidades">
      <bpmn:outgoing>Flow_Consulta</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="GW_Ingreso" name="Vía de ingreso / Auditoría UGDA" gatewayDirection="Converging">
      <bpmn:incoming>Flow_APS</bpmn:incoming>
      <bpmn:incoming>Flow_Urgencia</bpmn:incoming>
      <bpmn:incoming>Flow_InfCritico</bpmn:incoming>
      <bpmn:incoming>Flow_Consulta</bpmn:incoming>
      <bpmn:outgoing>Flow_IngresoToMed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_APS" sourceRef="Start_DerivAPS" targetRef="GW_Ingreso" />
    <bpmn:sequenceFlow id="Flow_Urgencia" sourceRef="Start_DerivUrgencia" targetRef="GW_Ingreso" />
    <bpmn:sequenceFlow id="Flow_InfCritico" sourceRef="Start_InformeCritico" targetRef="GW_Ingreso" />
    <bpmn:sequenceFlow id="Flow_Consulta" sourceRef="Start_DerivConsulta" targetRef="GW_Ingreso" />
    <bpmn:userTask id="Task_MedEvalua" name="Médico evalúa sospecha oncológica y deriva a UGCO">
      <bpmn:documentation>El médico de especialidad evalúa al paciente con sospecha de cáncer y lo deriva a la Unidad de Gestión de Casos Oncológicos para inicio del acompañamiento.</bpmn:documentation>
      <bpmn:incoming>Flow_IngresoToMed</bpmn:incoming>
      <bpmn:outgoing>Flow_MedToAsignar</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_IngresoToMed" sourceRef="GW_Ingreso" targetRef="Task_MedEvalua" />
    <bpmn:userTask id="Task_AsignarGestor" name="Asignar gestor oncológico de la especialidad">
      <bpmn:documentation>La enfermera supervisora o el equipo asigna un gestor responsable según la especialidad. Se consigna en la plataforma local y ficha clínica.</bpmn:documentation>
      <bpmn:incoming>Flow_MedToAsignar</bpmn:incoming>
      <bpmn:outgoing>Flow_AsignarToAdmin</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_MedToAsignar" sourceRef="Task_MedEvalua" targetRef="Task_AsignarGestor" />
    <bpmn:userTask id="Task_Admin_RegistroIngreso" name="Registrar ingreso, verificar datos de contacto y agendar primera atención">
      <bpmn:documentation>La administrativa registra el ingreso del caso, verifica los datos de contactabilidad y agenda la primera atención del gestor.</bpmn:documentation>
      <bpmn:incoming>Flow_AsignarToAdmin</bpmn:incoming>
      <bpmn:outgoing>Flow_AdminToContacto</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_AsignarToAdmin" sourceRef="Task_AsignarGestor" targetRef="Task_Admin_RegistroIngreso" />
    <bpmn:userTask id="Task_ContactoInicial" name="Realizar primer contacto obligatorio con paciente y cuidador">
      <bpmn:documentation>Punto de contacto obligatorio #1. El gestor brinda orientación sobre la trayectoria, identifica al cuidador principal, informa nombre y vía de contacto del gestor responsable.</bpmn:documentation>
      <bpmn:incoming>Flow_AdminToContacto</bpmn:incoming>
      <bpmn:outgoing>Flow_ContactoToValoracion</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_AdminToContacto" sourceRef="Task_Admin_RegistroIngreso" targetRef="Task_ContactoInicial" />
    <bpmn:userTask id="Task_ValoracionDominios" name="Aplicar valoración inicial por dominios (clínico, emocional, social, espiritual)">
      <bpmn:documentation>El gestor aplica la pauta de valoración inicial por dominios: clínico-funcional, emocional, familiar/cuidador, nutricional, socioeconómico, laboral/escolar, espiritual/cultural y comprensión de la información. Identifica necesidades de derivación multidisciplinaria.</bpmn:documentation>
      <bpmn:incoming>Flow_ContactoToValoracion</bpmn:incoming>
      <bpmn:outgoing>Flow_ValoracionToRegistro</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_ContactoToValoracion" sourceRef="Task_ContactoInicial" targetRef="Task_ValoracionDominios" />
    <bpmn:userTask id="Task_RegistroPlataforma" name="Registrar caso en plataforma local y ficha clínica">
      <bpmn:documentation>El gestor registra al paciente en la plataforma de registro local (herramienta digital institucional propia) y en la ficha clínica institucional. Nodo Crítico AS-05: esta plataforma no interopera con la Plataforma de Seguimiento Oncológico del MINSAL.</bpmn:documentation>
      <bpmn:incoming>Flow_ValoracionToRegistro</bpmn:incoming>
      <bpmn:outgoing>Flow_RegistroToOrdenes</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_ValoracionToRegistro" sourceRef="Task_ValoracionDominios" targetRef="Task_RegistroPlataforma" />
    <bpmn:userTask id="Task_MedEmiteOrdenes" name="Médico emite órdenes de exámenes (digital o papel)">
      <bpmn:documentation>El médico tratante emite las órdenes de exámenes (laboratorio, imágenes, biopsias, procedimientos) que pueden ser digitales o en papel.</bpmn:documentation>
      <bpmn:incoming>Flow_RegistroToOrdenes</bpmn:incoming>
      <bpmn:outgoing>Flow_OrdenesToGestor</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_RegistroToOrdenes" sourceRef="Task_RegistroPlataforma" targetRef="Task_MedEmiteOrdenes" />
    <bpmn:userTask id="Task_GestorSolicitaExam" name="Gestor tramita agendamiento de exámenes (correo electrónico)">
      <bpmn:documentation>El gestor oncológico solicita los exámenes a las unidades de apoyo vía correo electrónico. El gestor tramita directamente, no el paciente, para garantizar continuidad y evitar pérdidas.</bpmn:documentation>
      <bpmn:incoming>Flow_OrdenesToGestor</bpmn:incoming>
      <bpmn:outgoing>Flow_GestorToGWExamenTipo</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_OrdenesToGestor" sourceRef="Task_MedEmiteOrdenes" targetRef="Task_GestorSolicitaExam" />
    <bpmn:exclusiveGateway id="GW_ExamenTipo" name="¿Modalidad de examen requerida?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_GestorToGWExamenTipo</bpmn:incoming>
      <bpmn:outgoing>Flow_ExamenInterno</bpmn:outgoing>
      <bpmn:outgoing>Flow_ExamenExterno</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_GestorToGWExamenTipo" sourceRef="Task_GestorSolicitaExam" targetRef="GW_ExamenTipo" />
    <bpmn:sequenceFlow id="Flow_ExamenInterno" name="Rama Interna: Examen en HGF" sourceRef="GW_ExamenTipo" targetRef="Task_Admin_TramitaExam" />
    <bpmn:userTask id="Task_Admin_TramitaExam" name="Tramitar horas de exámenes con unidades de apoyo">
      <bpmn:documentation>El administrativo coordina exámenes con las unidades de apoyo (laboratorio, imagenología, procedimientos) y rescata resultados pendientes. Registra en libros pertinentes.</bpmn:documentation>
      <bpmn:incoming>Flow_ExamenInterno</bpmn:incoming>
      <bpmn:outgoing>Flow_AdminToNotif</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_Admin_NotifPaciente" name="Notificar al paciente fecha y hora de exámenes (teléfono)">
      <bpmn:documentation>La administrativa o TENS llama por teléfono al paciente para informarle fecha y hora de sus exámenes.</bpmn:documentation>
      <bpmn:incoming>Flow_AdminToNotif</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifToApoyo</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="Flow_AdminToNotif" sourceRef="Task_Admin_TramitaExam" targetRef="Task_Admin_NotifPaciente" />
    <bpmn:userTask id="Task_Apoyo_TomarMuestra" name="Realizar toma de muestras y exámenes">
      <bpmn:documentation>Las unidades de apoyo (laboratorio, imagenología, endoscopia, procedimientos programados) ejecutan los exámenes indicados.</bpmn:documentation>
      <bpmn:incoming>Flow_NotifToApoyo</bpmn:incoming>
      <bpmn:outgoing>Flow_MuestraToProc</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_NotifToApoyo" sourceRef="Task_Admin_NotifPaciente" targetRef="Task_Apoyo_TomarMuestra" />
    <bpmn:userTask id="Task_Apoyo_ProcesarExam" name="Procesar muestras y estudios">
      <bpmn:incoming>Flow_MuestraToProc</bpmn:incoming>
      <bpmn:outgoing>Flow_ProcToInforme</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_MuestraToProc" sourceRef="Task_Apoyo_TomarMuestra" targetRef="Task_Apoyo_ProcesarExam" />
    <bpmn:userTask id="Task_Apoyo_EmitirInforme" name="Emitir informes de resultados (biopsias, imágenes, laboratorio)">
      <bpmn:documentation>Las unidades emiten los resultados en distintas plataformas no interoperables (Nodo AS-01). Anatomía Patológica puede emitir informes críticos.</bpmn:documentation>
      <bpmn:incoming>Flow_ProcToInforme</bpmn:incoming>
      <bpmn:outgoing>Flow_InformeToRescatar</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_ProcToInforme" sourceRef="Task_Apoyo_ProcesarExam" targetRef="Task_Apoyo_EmitirInforme" />
    <bpmn:userTask id="Task_RescatarResultados" name="Rescatar resultados de distintas plataformas (sistemas no interoperables)">
      <bpmn:documentation>Nodo Crítico AS-01: El gestor busca los resultados manualmente en sistemas aislados (LIS, PACS, anatomía patológica). No existe interoperabilidad ni plataforma unificada.</bpmn:documentation>
      <bpmn:incoming>Flow_InformeToRescatar</bpmn:incoming>
      <bpmn:outgoing>Flow_RescatarToGW</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_InformeToRescatar" sourceRef="Task_Apoyo_EmitirInforme" targetRef="Task_RescatarResultados" />
    <bpmn:exclusiveGateway id="GW_ValoresCriticos" name="¿Existen valores críticos?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_RescatarToGW</bpmn:incoming>
      <bpmn:outgoing>Flow_SiCriticos</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoCriticos</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_RescatarToGW" sourceRef="Task_RescatarResultados" targetRef="GW_ValoresCriticos" />
    <bpmn:userTask id="Task_NotifCriticos" name="Notificar valores críticos al médico tratante de inmediato">
      <bpmn:incoming>Flow_SiCriticos</bpmn:incoming>
      <bpmn:outgoing>Flow_CriticosToConv</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_SiCriticos" name="Sí – Valores críticos" sourceRef="GW_ValoresCriticos" targetRef="Task_NotifCriticos" />
    <bpmn:sequenceFlow id="Flow_NoCriticos" name="No – Valores normales" sourceRef="GW_ValoresCriticos" targetRef="GW_ConvExamenes" />
    <bpmn:sequenceFlow id="Flow_CriticosToConv" sourceRef="Task_NotifCriticos" targetRef="GW_ConvExamenes" />
    <bpmn:sequenceFlow id="Flow_ExamenExterno" name="Rama Externa: Compra de servicio" sourceRef="GW_ExamenTipo" targetRef="Task_CompraServicio" />
    <bpmn:sendTask id="Task_CompraServicio" name="Solicitar compra de servicio externo (PET-CT, EBUS, marcadores moleculares)">
      <bpmn:documentation>Cuando el paciente requiere un estudio no disponible en el HGF ni en la red pública de derivación, el gestor gestiona la compra de servicio a centros privados (PET-CT, endosonografía, TACE, marcadores moleculares).</bpmn:documentation>
      <bpmn:incoming>Flow_ExamenExterno</bpmn:incoming>
      <bpmn:outgoing>Flow_CompraToRecibir</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="Flow_CompraToRecibir" sourceRef="Task_CompraServicio" targetRef="Task_RecibirResultExt" />
    <bpmn:receiveTask id="Task_RecibirResultExt" name="Recibir resultados de exámenes externos (centros privados)">
      <bpmn:documentation>El gestor recibe los resultados de los exámenes o procedimientos realizados en centros externos contratados por compra de servicio.</bpmn:documentation>
      <bpmn:incoming>Flow_CompraToRecibir</bpmn:incoming>
      <bpmn:outgoing>Flow_ResultExtToConv</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sequenceFlow id="Flow_ResultExtToConv" sourceRef="Task_RecibirResultExt" targetRef="GW_ConvExamenes" />
    <bpmn:exclusiveGateway id="GW_ConvExamenes" name="Convergencia de resultados de exámenes" gatewayDirection="Converging">
      <bpmn:incoming>Flow_NoCriticos</bpmn:incoming>
      <bpmn:incoming>Flow_CriticosToConv</bpmn:incoming>
      <bpmn:incoming>Flow_ResultExtToConv</bpmn:incoming>
      <bpmn:outgoing>Flow_ConvToEntrega</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ConvToEntrega" sourceRef="GW_ConvExamenes" targetRef="Task_EntregaResultMedico" />
    <bpmn:userTask id="Task_EntregaResultMedico" name="Entregar resultados completos al médico tratante">
      <bpmn:incoming>Flow_ConvToEntrega</bpmn:incoming>
      <bpmn:outgoing>Flow_EntregaToConfirm</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_EntregaToConfirm" sourceRef="Task_EntregaResultMedico" targetRef="GW_Confirmacion" />
    <bpmn:exclusiveGateway id="GW_Confirmacion" name="¿Se confirma diagnóstico oncológico?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_EntregaToConfirm</bpmn:incoming>
      <bpmn:outgoing>Flow_SiConfirma</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoConfirma</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_MedConfirmaDiag" name="Médico confirma diagnóstico oncológico">
      <bpmn:documentation>El médico tratante confirma el diagnóstico de cáncer. Es el responsable de la confirmación o descarte.</bpmn:documentation>
      <bpmn:incoming>Flow_SiConfirma</bpmn:incoming>
      <bpmn:outgoing>Flow_ConfToIPD</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_SiConfirma" name="Sí – Diagnóstico confirmado" sourceRef="GW_Confirmacion" targetRef="Task_MedConfirmaDiag" />
    <bpmn:exclusiveGateway id="GW_PostConfirmacion" name="Descarte – Fin del acompañamiento">
      <bpmn:incoming>Flow_NoConfirma</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_NoConfirma" name="No – Descartado" sourceRef="GW_Confirmacion" targetRef="GW_PostConfirmacion" />
    <bpmn:userTask id="Task_MedEmiteIPD" name="Emitir Informe de Proceso Diagnóstico (IPD) si es GES">
      <bpmn:documentation>Si la patología es GES, el médico emite el IPD que formaliza el diagnóstico. Si no es GES, queda consignado en la ficha clínica.</bpmn:documentation>
      <bpmn:incoming>Flow_ConfToIPD</bpmn:incoming>
      <bpmn:outgoing>Flow_IPDToComunica</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_ConfToIPD" sourceRef="Task_MedConfirmaDiag" targetRef="Task_MedEmiteIPD" />
    <bpmn:userTask id="Task_MedComunicaDiag" name="Comunicar diagnóstico al paciente y familia">
      <bpmn:documentation>El médico tratante comunica el diagnóstico confirmado al paciente. Este es un momento crítico de la trayectoria oncológica.</bpmn:documentation>
      <bpmn:incoming>Flow_IPDToComunica</bpmn:incoming>
      <bpmn:outgoing>Flow_ComunicaToGES</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_IPDToComunica" sourceRef="Task_MedEmiteIPD" targetRef="Task_MedComunicaDiag" />
    <bpmn:userTask id="Task_ConstanciaGES" name="Confeccionar constancia GES y remitir a Unidad GES (si corresponde)">
      <bpmn:documentation>El gestor confecciona la constancia GES en la etapa correspondiente y la remite a la Unidad GES. Nodo Crítico AS-04: el monitoreo de los plazos se realiza con planillas Excel manuales.</bpmn:documentation>
      <bpmn:incoming>Flow_ComunicaToGES</bpmn:incoming>
      <bpmn:outgoing>Flow_GESToPreparaComite</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_ComunicaToGES" sourceRef="Task_MedComunicaDiag" targetRef="Task_ConstanciaGES" />
    <bpmn:userTask id="Task_GestorPreparaComite" name="Preparar caso para presentación a comité oncológico">
      <bpmn:documentation>Nodo Crítico AS-02: El gestor verifica que los antecedentes estén completos, coordina con el médico la inclusión del caso en la tabla del comité y asesora en la preparación. La preparación es manual (Word) y las actas se registran en papel.</bpmn:documentation>
      <bpmn:incoming>Flow_GESToPreparaComite</bpmn:incoming>
      <bpmn:outgoing>Flow_PreparaToMedComite</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_GESToPreparaComite" sourceRef="Task_ConstanciaGES" targetRef="Task_GestorPreparaComite" />
    <bpmn:userTask id="Task_MedPreparaComite" name="Médico presenta caso al comité oncológico">
      <bpmn:documentation>El médico tratante presenta formalmente el caso al comité oncológico regional con todos los antecedentes.</bpmn:documentation>
      <bpmn:incoming>Flow_PreparaToMedComite</bpmn:incoming>
      <bpmn:outgoing>Flow_MedToComite</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_PreparaToMedComite" sourceRef="Task_GestorPreparaComite" targetRef="Task_MedPreparaComite" />
    <bpmn:userTask id="Task_ComiteEvalua" name="Comité oncológico evalúa integralmente el caso">
      <bpmn:documentation>El comité oncológico, compuesto por oncólogos, cirujanos, radioterapeutas, hematólogos y paliativistas, evalúa integralmente a la persona con cáncer.</bpmn:documentation>
      <bpmn:incoming>Flow_MedToComite</bpmn:incoming>
      <bpmn:outgoing>Flow_EvaluaToResol</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_MedToComite" sourceRef="Task_MedPreparaComite" targetRef="Task_ComiteEvalua" />
    <bpmn:userTask id="Task_ComiteResolucion" name="Dictar resolución terapéutica y registrar acta (REM 0.7)">
      <bpmn:documentation>El comité emite su resolución: cirugía, terapia sistémica, radioterapia, cuidados paliativos u otra modalidad. Se registra en acta con asistencia y resolución por paciente.</bpmn:documentation>
      <bpmn:incoming>Flow_EvaluaToResol</bpmn:incoming>
      <bpmn:outgoing>Flow_ResolToGestor</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_EvaluaToResol" sourceRef="Task_ComiteEvalua" targetRef="Task_ComiteResolucion" />
    <bpmn:userTask id="Task_Gestor_InformaComite" name="Contactar al paciente para informar resolución de comité">
      <bpmn:documentation>Punto de contacto obligatorio #3. El gestor contacta al paciente tras la comunicación del médico para explicar los pasos siguientes en lenguaje claro y verificar comprensión.</bpmn:documentation>
      <bpmn:incoming>Flow_ResolToGestor</bpmn:incoming>
      <bpmn:outgoing>Flow_InformaToGWTrat</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_ResolToGestor" sourceRef="Task_ComiteResolucion" targetRef="Task_Gestor_InformaComite" />
    <bpmn:exclusiveGateway id="GW_TipoTratamiento" name="¿Qué tratamiento indica la resolución?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_InformaToGWTrat</bpmn:incoming>
      <bpmn:outgoing>Flow_Cirugia</bpmn:outgoing>
      <bpmn:outgoing>Flow_QTHemato</bpmn:outgoing>
      <bpmn:outgoing>Flow_DerivExterna</bpmn:outgoing>
      <bpmn:outgoing>Flow_Paliativos</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_InformaToGWTrat" sourceRef="Task_Gestor_InformaComite" targetRef="GW_TipoTratamiento" />
    <bpmn:userTask id="Task_GestorCirugiaLEIQ" name="Ingresar a lista de espera quirúrgica (LEIQ) del HGF">
      <bpmn:documentation>El médico clasifica la solicitud quirúrgica en SIGTE (ONCO DIAGNÓSTICO, ONCO TRATAMIENTO, ONCO REHABILITACIÓN). El gestor verifica que el ingreso a LEIQ sea correcto. La administración de la lista corresponde a UGAC/UGDA.</bpmn:documentation>
      <bpmn:incoming>Flow_Cirugia</bpmn:incoming>
      <bpmn:outgoing>Flow_CirugiaToPostTrat</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Cirugia" name="Cirugía en HGF" sourceRef="GW_TipoTratamiento" targetRef="Task_GestorCirugiaLEIQ" />
    <bpmn:userTask id="Task_GestorQTHemato" name="Programar QT hematológica (adulto/niño) en HGF">
      <bpmn:documentation>Los tumores líquidos (cánceres hematológicos) de adulto y niño se tratan en el Hospital Fricke. Se programa y administra la quimioterapia dentro del hospital.</bpmn:documentation>
      <bpmn:incoming>Flow_QTHemato</bpmn:incoming>
      <bpmn:outgoing>Flow_QTToPostTrat</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_QTHemato" name="QT Hematológica (HGF)" sourceRef="GW_TipoTratamiento" targetRef="Task_GestorQTHemato" />
    <bpmn:exclusiveGateway id="GW_DerivExterna" name="Derivación a red externa (RT / QT sólida)">
      <bpmn:incoming>Flow_DerivExterna</bpmn:incoming>
      <bpmn:outgoing>Flow_DerivToTENS</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_DerivExterna" name="QT Tumor Sólido / Radioterapia" sourceRef="GW_TipoTratamiento" targetRef="GW_DerivExterna" />
    <bpmn:userTask id="Task_TENS_Dossier" name="Confeccionar dossier físico con documentación completa">
      <bpmn:documentation>Nodo Crítico AS-03: El TENS confecciona el dossier con toda la documentación requerida (interconsulta, informes, biopsias, imágenes) en formato físico y lo entrega a UGAA para derivación al centro de referencia.</bpmn:documentation>
      <bpmn:incoming>Flow_DerivToTENS</bpmn:incoming>
      <bpmn:outgoing>Flow_DossierToUGAA</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_DerivToTENS" sourceRef="GW_DerivExterna" targetRef="Task_TENS_Dossier" />
    <bpmn:sendTask id="Task_UGAA_Derivar" name="Derivar dossier al centro de referencia (HCVB u otro)">
      <bpmn:documentation>UGAA envía el dossier físico al centro de referencia (Hospital Carlos Van Buren u otro de la macrored). A partir de este punto se pierde la visibilidad del paciente (Nodo AS-03).</bpmn:documentation>
      <bpmn:incoming>Flow_DossierToUGAA</bpmn:incoming>
      <bpmn:outgoing>Flow_UGAAToContraRef</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="Flow_DossierToUGAA" sourceRef="Task_TENS_Dossier" targetRef="Task_UGAA_Derivar" />
    <bpmn:receiveTask id="Task_RecibirContraRef" name="Recibir contrarreferencia / epicrisis del centro derivado">
      <bpmn:documentation>El gestor recibe la epicrisis y contrarreferencia del centro de referencia una vez finalizado el tratamiento externo. Solicita interconsulta por sistema para dar continuidad.</bpmn:documentation>
      <bpmn:incoming>Flow_UGAAToContraRef</bpmn:incoming>
      <bpmn:outgoing>Flow_ContraRefToPostTrat</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sequenceFlow id="Flow_UGAAToContraRef" sourceRef="Task_UGAA_Derivar" targetRef="Task_RecibirContraRef" />
    <bpmn:userTask id="Task_GestorDerivaPaliativos" name="Derivar a Cuidados Paliativos y Alivio del Dolor">
      <bpmn:documentation>Pacientes con cáncer avanzado que requieren cuidados paliativos. El ingreso lo realiza el médico tratante mediante IPD y SIC. Continúan siendo acompañados por el gestor.</bpmn:documentation>
      <bpmn:incoming>Flow_Paliativos</bpmn:incoming>
      <bpmn:outgoing>Flow_PaliativosToPostTrat</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Paliativos" name="Cuidados Paliativos" sourceRef="GW_TipoTratamiento" targetRef="Task_GestorDerivaPaliativos" />
    <bpmn:exclusiveGateway id="GW_PostTratInterno" name="Convergencia post-tratamiento" gatewayDirection="Converging">
      <bpmn:incoming>Flow_CirugiaToPostTrat</bpmn:incoming>
      <bpmn:incoming>Flow_QTToPostTrat</bpmn:incoming>
      <bpmn:incoming>Flow_ContraRefToPostTrat</bpmn:incoming>
      <bpmn:incoming>Flow_PaliativosToPostTrat</bpmn:incoming>
      <bpmn:outgoing>Flow_PostTratToMultidisc</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_CirugiaToPostTrat" sourceRef="Task_GestorCirugiaLEIQ" targetRef="GW_PostTratInterno" />
    <bpmn:sequenceFlow id="Flow_QTToPostTrat" sourceRef="Task_GestorQTHemato" targetRef="GW_PostTratInterno" />
    <bpmn:sequenceFlow id="Flow_ContraRefToPostTrat" sourceRef="Task_RecibirContraRef" targetRef="GW_PostTratInterno" />
    <bpmn:sequenceFlow id="Flow_PaliativosToPostTrat" sourceRef="Task_GestorDerivaPaliativos" targetRef="GW_PostTratInterno" />
    <bpmn:userTask id="Task_DerivarMultidisc" name="Evaluar y derivar a equipo multidisciplinario (psicosocial, nutrición, kinesiología, etc.)">
      <bpmn:documentation>El gestor evalúa necesidades de rehabilitación y deriva: dupla psicosocial, nutrición oncológica, kinesiología, fonoaudiología, terapia ocupacional, enfermería de ostomías, hospitalización domiciliaria. También evalúa al cuidador principal ante signos de sobrecarga.</bpmn:documentation>
      <bpmn:incoming>Flow_PostTratToMultidisc</bpmn:incoming>
      <bpmn:outgoing>Flow_MultidiscToGWInicioSeg</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_PostTratToMultidisc" sourceRef="GW_PostTratInterno" targetRef="Task_DerivarMultidisc" />
    <bpmn:parallelGateway id="GW_InicioSeguimiento" name="Inicio seguimiento continuo simultáneo" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_MultidiscToGWInicioSeg</bpmn:incoming>
      <bpmn:outgoing>Flow_SeguimientoGestor</bpmn:outgoing>
      <bpmn:outgoing>Flow_SeguimientoTENS</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_MultidiscToGWInicioSeg" sourceRef="Task_DerivarMultidisc" targetRef="GW_InicioSeguimiento" />
    <bpmn:sequenceFlow id="Flow_SeguimientoGestor" sourceRef="GW_InicioSeguimiento" targetRef="Task_SeguimientoPeriodico" />
    <bpmn:userTask id="Task_SeguimientoPeriodico" name="Seguimiento periódico del paciente y sobrevivientes">
      <bpmn:documentation>El gestor asegura controles periódicos (3, 6, 12 meses o 5 años), mantiene contactabilidad, pesquisa inasistencias y acompaña el retorno a la vida cotidiana. Nodo Crítico AS-06: la demanda espontánea interrumpe esta labor.</bpmn:documentation>
      <bpmn:incoming>Flow_SeguimientoGestor</bpmn:incoming>
      <bpmn:outgoing>Flow_GestorToGWFinSeg</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_GestorToGWFinSeg" sourceRef="Task_SeguimientoPeriodico" targetRef="GW_FinSeguimiento" />
    <bpmn:sequenceFlow id="Flow_SeguimientoTENS" sourceRef="GW_InicioSeguimiento" targetRef="Task_TENS_Contactabilidad" />
    <bpmn:userTask id="Task_TENS_Contactabilidad" name="Mantener contactabilidad con pacientes (teléfono, correo, presencial)">
      <bpmn:documentation>El TENS apoya en mantener la contactabilidad con los pacientes vía telefónica, correo electrónico y presencial. Realiza seguimiento de exámenes y agenda en plataformas institucionales.</bpmn:documentation>
      <bpmn:incoming>Flow_SeguimientoTENS</bpmn:incoming>
      <bpmn:outgoing>Flow_TENSToGWFinSeg</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_TENSToGWFinSeg" sourceRef="Task_TENS_Contactabilidad" targetRef="GW_FinSeguimiento" />
    <bpmn:parallelGateway id="GW_FinSeguimiento" name="Convergencia de etapa de seguimiento" gatewayDirection="Converging">
      <bpmn:incoming>Flow_GestorToGWFinSeg</bpmn:incoming>
      <bpmn:incoming>Flow_TENSToGWFinSeg</bpmn:incoming>
      <bpmn:outgoing>Flow_SeguimientoToGWCierre</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_SeguimientoToGWCierre" sourceRef="GW_FinSeguimiento" targetRef="GW_CierreCaso" />
    <bpmn:exclusiveGateway id="GW_CierreCaso" name="¿Criterio de cierre?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_SeguimientoToGWCierre</bpmn:incoming>
      <bpmn:outgoing>Flow_Remision</bpmn:outgoing>
      <bpmn:outgoing>Flow_Fallecimiento</bpmn:outgoing>
      <bpmn:outgoing>Flow_TrasladoCentro</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ContraRefAPS" name="Coordinar contrarreferencia a APS y cerrar caso">
      <bpmn:documentation>Finalizado el proceso de atención en especialidad, el gestor coordina el retorno a APS con la información necesaria para continuidad del cuidado. Registra cierre en plataforma local y ficha clínica.</bpmn:documentation>
      <bpmn:incoming>Flow_Remision</bpmn:incoming>
      <bpmn:outgoing>Flow_ContraRefToEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Remision" name="Remisión / Alta clínica" sourceRef="GW_CierreCaso" targetRef="Task_ContraRefAPS" />
    <bpmn:endEvent id="End_AltaAPS" name="Caso cerrado – Alta a APS">
      <bpmn:incoming>Flow_ContraRefToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ContraRefToEnd" sourceRef="Task_ContraRefAPS" targetRef="End_AltaAPS" />
    <bpmn:endEvent id="End_Fallecimiento" name="Caso cerrado – Fallecimiento">
      <bpmn:incoming>Flow_Fallecimiento</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Fallecimiento" name="Fallecimiento" sourceRef="GW_CierreCaso" targetRef="End_Fallecimiento" />
    <bpmn:endEvent id="End_Traslado" name="Caso cerrado – Traslado a otro centro">
      <bpmn:incoming>Flow_TrasladoCentro</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_TrasladoCentro" name="Traslado" sourceRef="GW_CierreCaso" targetRef="End_Traslado" />
  </bpmn:process>
  <bpmn:process id="Proc_Paciente" name="Paciente y Cuidador Principal" isExecutable="false">
    <bpmn:startEvent id="Start_Pac" name="Paciente recibe derivación">
      <bpmn:outgoing>Flow_PacStart</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Pac_RecibeOrientacion" name="Recibir orientación del gestor sobre trayectoria oncológica">
      <bpmn:incoming>Flow_PacStart</bpmn:incoming>
      <bpmn:outgoing>Flow_PacOrientToNotif</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_PacStart" sourceRef="Start_Pac" targetRef="Task_Pac_RecibeOrientacion" />
    <bpmn:userTask id="Task_Pac_RecibeNotif" name="Recibir notificación de fecha de exámenes">
      <bpmn:incoming>Flow_PacOrientToNotif</bpmn:incoming>
      <bpmn:outgoing>Flow_PacNotifToAsist</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_PacOrientToNotif" sourceRef="Task_Pac_RecibeOrientacion" targetRef="Task_Pac_RecibeNotif" />
    <bpmn:userTask id="Task_Pac_AsistExamen" name="Asistir presencialmente a toma de exámenes">
      <bpmn:incoming>Flow_PacNotifToAsist</bpmn:incoming>
      <bpmn:outgoing>Flow_PacAsistToInfo</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_PacNotifToAsist" sourceRef="Task_Pac_RecibeNotif" targetRef="Task_Pac_AsistExamen" />
    <bpmn:userTask id="Task_Pac_RecibeInfoComite" name="Recibir información de resolución de comité y plan terapéutico">
      <bpmn:incoming>Flow_PacAsistToInfo</bpmn:incoming>
      <bpmn:outgoing>Flow_PacInfoToTrat</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_PacAsistToInfo" sourceRef="Task_Pac_AsistExamen" targetRef="Task_Pac_RecibeInfoComite" />
    <bpmn:userTask id="Task_Pac_EnTratamiento" name="Paciente en tratamiento y seguimiento continuo">
      <bpmn:incoming>Flow_PacInfoToTrat</bpmn:incoming>
      <bpmn:outgoing>Flow_PacToEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_PacInfoToTrat" sourceRef="Task_Pac_RecibeInfoComite" targetRef="Task_Pac_EnTratamiento" />
    <bpmn:endEvent id="End_Pac" name="Alta / Cierre de acompañamiento">
      <bpmn:incoming>Flow_PacToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_PacToEnd" sourceRef="Task_Pac_EnTratamiento" targetRef="End_Pac" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ASIS">
    <bpmndi:BPMNPlane id="BPMNPlane_ASIS" bpmnElement="Collab_ASIS">
      <bpmndi:BPMNShape id="Pool_HGF_di" bpmnElement="Pool_HGF" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="4700" height="1380" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Apoyo_di" bpmnElement="Lane_Apoyo" isHorizontal="true">
        <dc:Bounds x="190" y="1320" width="4670" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Comite_di" bpmnElement="Lane_Comite" isHorizontal="true">
        <dc:Bounds x="190" y="1200" width="4670" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_GES_di" bpmnElement="Lane_GES" isHorizontal="true">
        <dc:Bounds x="190" y="1100" width="4670" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_UGAA_di" bpmnElement="Lane_UGAA" isHorizontal="true">
        <dc:Bounds x="190" y="1000" width="4670" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Admin_di" bpmnElement="Lane_Admin" isHorizontal="true">
        <dc:Bounds x="190" y="880" width="4670" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_TENS_di" bpmnElement="Lane_TENS" isHorizontal="true">
        <dc:Bounds x="190" y="760" width="4670" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Gestor_di" bpmnElement="Lane_Gestor" isHorizontal="true">
        <dc:Bounds x="190" y="480" width="4670" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Medico_di" bpmnElement="Lane_Medico" isHorizontal="true">
        <dc:Bounds x="190" y="320" width="4670" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_UGDA_di" bpmnElement="Lane_UGDA" isHorizontal="true">
        <dc:Bounds x="190" y="200" width="4670" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_APS_di" bpmnElement="Lane_APS" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="4670" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataObj_FichaClinica_di" bpmnElement="DataObj_FichaClinica">
        <dc:Bounds x="580" y="620" width="36" height="50" />
