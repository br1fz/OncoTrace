<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_ASIS_HGF" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.0">
  <bpmn:collaboration id="Collaboration_ASIS">
    <bpmn:participant id="Pool_HGF" name="Hospital Dr. Gustavo Fricke – Gestión Oncológica (AS-IS)" processRef="Process_HGF" />
    <bpmn:participant id="Pool_HCVB" name="Hospital Carlos Van Buren (Radioterapia / QT Tumores Sólidos)" />
    <bpmn:participant id="Pool_Privados" name="Centros de Salud Privados / Clínicas (PET-CT, EBUS, Ablación)" />
    <bpmn:messageFlow id="MsgFlow_QTSolida_VB" name="Derivación QT Cáncer Sólido" sourceRef="IntermediateThrow_DerivacionQTSolida" targetRef="Pool_HCVB" />
    <bpmn:messageFlow id="MsgFlow_Radio_VB" name="Derivación Radioterapia" sourceRef="IntermediateThrow_DerivacionRadio" targetRef="Pool_HCVB" />
    <bpmn:messageFlow id="MsgFlow_CompraServicio" name="Solicitud Compra de Servicio (PET-CT / EBUS / Ablación)" sourceRef="Task_SolicitarCompraServicio" targetRef="Pool_Privados" />
    <bpmn:messageFlow id="MsgFlow_ResultadosPrivados" name="Resultados de Exámenes Externos" sourceRef="Pool_Privados" targetRef="Task_RecibirResultadosExternos" />
  </bpmn:collaboration>
  <bpmn:process id="Process_HGF" name="Gestión Oncológica AS-IS – Hospital Dr. Gustavo Fricke" isExecutable="false">
    <bpmn:laneSet id="LaneSet_HGF">
      <bpmn:lane id="Lane_Paciente" name="Paciente / Familia">
        <bpmn:flowNodeRef>Task_PresentarseCAE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecibirNotificacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConsultaEspontanea</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PacienteEnTratamientoFricke</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PacienteListaEsperaQx</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_TratamientoFricke</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Medico" name="Médico Oncólogo / Comité Oncológico">
        <bpmn:flowNodeRef>Start_TrasladoRed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EmitirOrdenExamenes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RevisarResultadosNormales</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecibirAlertaCritica</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PresentarComite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Tratamiento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DefinirCirugia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProgramarQTHemato</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateThrow_DerivacionQTSolida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateThrow_DerivacionRadio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DefinirCuidadosPaliativos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_DerivacionConsulta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_DerivacionComite</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Gestor" name="Gestor Oncológico (Enfermero / Matrón)">
        <bpmn:flowNodeRef>Task_RecibirPaciente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrientarPaciente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SolicitarAgendamiento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecibirConfirmacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RescatarResultados</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ValidacionExamenes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotificarValoresCriticos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PasarResultadosMedico</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SolicitarCompraServicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecibirResultadosExternos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrazarPacientePlataforma</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DerivarDuplaPsicosocial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DerivarNutricion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SeguimientoGestor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_DerivadoExterno</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Secretaria" name="Secretaría Oncológica">
        <bpmn:flowNodeRef>Task_LlamarPaciente</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CAE" name="CAE (Centro de Atención de Especialidades) / Laboratorio">
        <bpmn:flowNodeRef>Task_ConfirmarAgendamiento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TomarMuestra</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_TrasladoRed" name="Traslado en red (otro servicio de salud o cambio de domicilio)">
      <bpmn:documentation>El paciente se traslada de zona geográfica y debe continuar su atención oncológica en el Hospital Fricke. También incluye referencia entre especialidades dentro de la misma red.</bpmn:documentation>
      <bpmn:outgoing>Flow_InicioTraslado</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_Inicio" name="Vía de ingreso del paciente" gatewayDirection="Converging">
      <bpmn:incoming>Flow_InicioConsulta</bpmn:incoming>
      <bpmn:incoming>Flow_InicioComite</bpmn:incoming>
      <bpmn:incoming>Flow_InicioTraslado</bpmn:incoming>
      <bpmn:outgoing>Flow_InicioToRecepcion</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_InicioConsulta" sourceRef="Start_DerivacionConsulta" targetRef="Gateway_Inicio" />
    <bpmn:sequenceFlow id="Flow_InicioComite" sourceRef="Start_DerivacionComite" targetRef="Gateway_Inicio" />
    <bpmn:sequenceFlow id="Flow_InicioTraslado" sourceRef="Start_TrasladoRed" targetRef="Gateway_Inicio" />
    <bpmn:userTask id="Task_RecibirPaciente" name="Recibir al paciente y asignarlo a gestor oncológico de la especialidad">
      <bpmn:documentation>El paciente ingresa al modelo de gestión y queda a cargo de un gestor oncológico específico de la especialidad. Los gestores son mayoritariamente enfermeros.</bpmn:documentation>
      <bpmn:incoming>Flow_InicioToRecepcion</bpmn:incoming>
      <bpmn:outgoing>Flow_RecepcionToOrientar</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_InicioToRecepcion" sourceRef="Gateway_Inicio" targetRef="Task_RecibirPaciente" />
    <bpmn:userTask id="Task_OrientarPaciente" name="Orientar al paciente y familia sobre el proceso oncológico">
      <bpmn:documentation>El gestor da indicaciones, orienta al paciente y su familia sobre el proceso que va a comenzar a transitar. El acompañamiento es holístico según la Ley del Cáncer.</bpmn:documentation>
      <bpmn:incoming>Flow_RecepcionToOrientar</bpmn:incoming>
      <bpmn:outgoing>Flow_OrientarToConsulta</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_RecepcionToOrientar" sourceRef="Task_RecibirPaciente" targetRef="Task_OrientarPaciente" />
    <bpmn:userTask id="Task_ConsultaEspontanea" name="Consulta espontánea del paciente (RRSS, boca a boca)">
      <bpmn:documentation>Pacientes que se han enterado por redes sociales o de boca a boca de la unidad de gestión oncológica y hacen consulta espontánea. Genera alta demanda no planificada.</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:userTask id="Task_EmitirOrdenExamenes" name="Emitir orden de exámenes obligatorios (digital o papel)">
      <bpmn:documentation>El médico emite la orden de exámenes que pueden ser en formato digital o en hoja de papel y los entrega al gestor oncológico. Los exámenes pueden incluir laboratorio, resonancia, escáner, biopsias, entre otros.</bpmn:documentation>
      <bpmn:incoming>Flow_OrientarToConsulta</bpmn:incoming>
      <bpmn:outgoing>Flow_OrdenToSolicitar</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_OrientarToConsulta" sourceRef="Task_OrientarPaciente" targetRef="Task_EmitirOrdenExamenes" />
    <bpmn:sendTask id="Task_SolicitarAgendamiento" name="Solicitar agendamiento a unidad de toma de muestra (vía correo electrónico)">
      <bpmn:documentation>El gestor oncológico solicita el agendamiento de los exámenes a la unidad de toma de muestra del CAE vía correo electrónico. El gestor tramita los exámenes, no el paciente, para garantizar la continuidad y evitar pérdidas en la gestión.</bpmn:documentation>
      <bpmn:incoming>Flow_OrdenToSolicitar</bpmn:incoming>
      <bpmn:outgoing>Flow_SolicitarToConfirmar</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="Flow_OrdenToSolicitar" sourceRef="Task_EmitirOrdenExamenes" targetRef="Task_SolicitarAgendamiento" />
    <bpmn:receiveTask id="Task_ConfirmarAgendamiento" name="Enviar confirmación de agendamiento (vía correo electrónico)">
      <bpmn:documentation>La unidad de toma de muestra del CAE envía la confirmación de agendamiento al gestor oncológico vía correo electrónico.</bpmn:documentation>
      <bpmn:incoming>Flow_SolicitarToConfirmar</bpmn:incoming>
      <bpmn:outgoing>Flow_ConfirmarToRecibir</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sequenceFlow id="Flow_SolicitarToConfirmar" sourceRef="Task_SolicitarAgendamiento" targetRef="Task_ConfirmarAgendamiento" />
    <bpmn:userTask id="Task_RecibirConfirmacion" name="Recibir confirmación de agendamiento del CAE">
      <bpmn:documentation>El gestor recibe la confirmación de fecha y hora para los exámenes del paciente.</bpmn:documentation>
      <bpmn:incoming>Flow_ConfirmarToRecibir</bpmn:incoming>
      <bpmn:outgoing>Flow_RecibirToLlamar</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_ConfirmarToRecibir" sourceRef="Task_ConfirmarAgendamiento" targetRef="Task_RecibirConfirmacion" />
    <bpmn:userTask id="Task_LlamarPaciente" name="Llamar por teléfono al paciente para notificar fecha del examen">
      <bpmn:documentation>La secretaría oncológica llama por teléfono al paciente para avisarle de la fecha y hora de su cita de toma de muestra.</bpmn:documentation>
      <bpmn:incoming>Flow_RecibirToLlamar</bpmn:incoming>
      <bpmn:outgoing>Flow_LlamarToNotificar</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_RecibirToLlamar" sourceRef="Task_RecibirConfirmacion" targetRef="Task_LlamarPaciente" />
    <bpmn:userTask id="Task_RecibirNotificacion" name="Paciente recibe notificación telefónica de la cita">
      <bpmn:documentation>El paciente recibe la llamada telefónica con la fecha de su examen.</bpmn:documentation>
      <bpmn:incoming>Flow_LlamarToNotificar</bpmn:incoming>
      <bpmn:outgoing>Flow_NotificarToPresentar</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_LlamarToNotificar" sourceRef="Task_LlamarPaciente" targetRef="Task_RecibirNotificacion" />
    <bpmn:userTask id="Task_PresentarseCAE" name="Paciente se presenta físicamente en el CAE para toma de muestra">
      <bpmn:documentation>El paciente asiste presencialmente al Centro de Atención de Especialidades (CAE), área de toma de muestra, para realizarse los exámenes el mismo día.</bpmn:documentation>
      <bpmn:incoming>Flow_NotificarToPresentar</bpmn:incoming>
      <bpmn:outgoing>Flow_PresentarToTomar</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_NotificarToPresentar" sourceRef="Task_RecibirNotificacion" targetRef="Task_PresentarseCAE" />
    <bpmn:userTask id="Task_TomarMuestra" name="Realizar toma de muestra y exámenes de laboratorio">
      <bpmn:documentation>Personal del CAE/Laboratorio realiza la toma de muestra y exámenes de laboratorio indicados por el médico.</bpmn:documentation>
      <bpmn:incoming>Flow_PresentarToTomar</bpmn:incoming>
      <bpmn:outgoing>Flow_TomarToRescatar</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_PresentarToTomar" sourceRef="Task_PresentarseCAE" targetRef="Task_TomarMuestra" />
    <bpmn:userTask id="Task_RescatarResultados" name="Rescatar resultados de distintas plataformas (sistemas legados no interoperables)">
      <bpmn:documentation>El gestor oncológico rescata los resultados de las distintas plataformas del hospital. No hay interoperabilidad ni una plataforma unificada: existen distintas plataformas para exámenes de sangre, resonancia, y otros exámenes de apoyo. El gestor evalúa los parámetros.</bpmn:documentation>
      <bpmn:incoming>Flow_TomarToRescatar</bpmn:incoming>
      <bpmn:outgoing>Flow_RescatarToTraza</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_TomarToRescatar" sourceRef="Task_TomarMuestra" targetRef="Task_RescatarResultados" />
    <bpmn:userTask id="Task_TrazarPacientePlataforma" name="Registrar trazabilidad del paciente en plataforma de creación propia">
      <bpmn:documentation>Los gestores registran y trazan al paciente en una plataforma de creación propia para dar seguimiento a su estado (en qué va el paciente).</bpmn:documentation>
      <bpmn:incoming>Flow_RescatarToTraza</bpmn:incoming>
      <bpmn:outgoing>Flow_TrazaToGateway1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_RescatarToTraza" sourceRef="Task_RescatarResultados" targetRef="Task_TrazarPacientePlataforma" />
    <bpmn:exclusiveGateway id="Gateway_ValidacionExamenes" name="¿Existen valores críticos en los exámenes?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_TrazaToGateway1</bpmn:incoming>
      <bpmn:outgoing>Flow_ValoresCriticos</bpmn:outgoing>
      <bpmn:outgoing>Flow_ValoresNormales</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_TrazaToGateway1" sourceRef="Task_TrazarPacientePlataforma" targetRef="Gateway_ValidacionExamenes" />
    <bpmn:userTask id="Task_NotificarValoresCriticos" name="Notificar inmediatamente valores críticos al médico tratante">
      <bpmn:documentation>Cuando los exámenes arrojan valores críticos, el gestor debe avisar inmediatamente al médico tratante para toma de decisiones urgente.</bpmn:documentation>
      <bpmn:incoming>Flow_ValoresCriticos</bpmn:incoming>
      <bpmn:outgoing>Flow_CriticosToMedico</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_ValoresCriticos" name="Sí – Valores críticos" sourceRef="Gateway_ValidacionExamenes" targetRef="Task_NotificarValoresCriticos" />
    <bpmn:userTask id="Task_RecibirAlertaCritica" name="Médico recibe alerta de valores críticos y evalúa acciones">
      <bpmn:documentation>El médico tratante recibe la notificación de valores críticos y evalúa las acciones urgentes a tomar.</bpmn:documentation>
      <bpmn:incoming>Flow_CriticosToMedico</bpmn:incoming>
      <bpmn:outgoing>Flow_AlertaToComite</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_CriticosToMedico" sourceRef="Task_NotificarValoresCriticos" targetRef="Task_RecibirAlertaCritica" />
    <bpmn:userTask id="Task_PasarResultadosMedico" name="Pasar resultados al médico/comité para etapificación">
      <bpmn:documentation>Cuando los valores son normales, el gestor pasa los resultados al médico o comité oncológico para que puedan realizar la etapificación y definir el objetivo terapéutico.</bpmn:documentation>
      <bpmn:incoming>Flow_ValoresNormales</bpmn:incoming>
      <bpmn:outgoing>Flow_NormalesToMedico</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_ValoresNormales" name="No – Valores normales" sourceRef="Gateway_ValidacionExamenes" targetRef="Task_PasarResultadosMedico" />
    <bpmn:userTask id="Task_RevisarResultadosNormales" name="Médico revisa resultados y prepara presentación a comité">
      <bpmn:documentation>El médico oncólogo revisa los resultados entregados por el gestor y prepara la ficha para presentar al comité oncológico.</bpmn:documentation>
      <bpmn:incoming>Flow_NormalesToMedico</bpmn:incoming>
      <bpmn:incoming>Flow_AlertaToComite</bpmn:incoming>
      <bpmn:outgoing>Flow_RevisarToComite</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_NormalesToMedico" sourceRef="Task_PasarResultadosMedico" targetRef="Task_RevisarResultadosNormales" />
    <bpmn:sequenceFlow id="Flow_AlertaToComite" sourceRef="Task_RecibirAlertaCritica" targetRef="Task_RevisarResultadosNormales" />
    <bpmn:userTask id="Task_PresentarComite" name="Presentar paciente al Comité Oncológico para definición de tratamiento">
      <bpmn:documentation>El caso del paciente se presenta al comité oncológico. El comité decide qué tipo de tratamiento recibe: quirúrgico, quimioterapia, radioterapia, o cuidados paliativos. Cada caso es individual y depende de la etapa de la enfermedad.</bpmn:documentation>
      <bpmn:incoming>Flow_RevisarToComite</bpmn:incoming>
      <bpmn:outgoing>Flow_ComiteToGateway2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_RevisarToComite" sourceRef="Task_RevisarResultadosNormales" targetRef="Task_PresentarComite" />
    <bpmn:exclusiveGateway id="Gateway_Tratamiento" name="¿Qué tipo de tratamiento requiere el paciente?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_ComiteToGateway2</bpmn:incoming>
      <bpmn:outgoing>Flow_Cirugia</bpmn:outgoing>
      <bpmn:outgoing>Flow_QTHematologico</bpmn:outgoing>
      <bpmn:outgoing>Flow_QTSolido</bpmn:outgoing>
      <bpmn:outgoing>Flow_Radioterapia</bpmn:outgoing>
      <bpmn:outgoing>Flow_Paliativos</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ComiteToGateway2" sourceRef="Task_PresentarComite" targetRef="Gateway_Tratamiento" />
    <bpmn:userTask id="Task_DefinirCirugia" name="Ingreso a lista de espera quirúrgica del Hospital Fricke">
      <bpmn:documentation>Si el paciente requiere cirugía, se realiza en el Hospital Fricke. El paciente ingresa a la lista de espera quirúrgica.</bpmn:documentation>
      <bpmn:incoming>Flow_Cirugia</bpmn:incoming>
      <bpmn:outgoing>Flow_CirugiaToListaEspera</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Cirugia" name="Requiere Cirugía" sourceRef="Gateway_Tratamiento" targetRef="Task_DefinirCirugia" />
    <bpmn:userTask id="Task_PacienteListaEsperaQx" name="Paciente en lista de espera quirúrgica">
      <bpmn:documentation>El paciente queda en espera de la cirugía, acompañado por el gestor oncológico.</bpmn:documentation>
      <bpmn:incoming>Flow_CirugiaToListaEspera</bpmn:incoming>
      <bpmn:outgoing>Flow_ListaEsperaToSeguimiento</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_CirugiaToListaEspera" sourceRef="Task_DefinirCirugia" targetRef="Task_PacienteListaEsperaQx" />
    <bpmn:userTask id="Task_ProgramarQTHemato" name="Programar y administrar QT hematológica (adulto/niño) en Hospital Fricke">
      <bpmn:documentation>Los tumores líquidos (cánceres hematológicos de sangre) tanto de adulto como de niño se tratan en el Hospital Fricke. Se programa y administra la quimioterapia dentro del hospital.</bpmn:documentation>
      <bpmn:incoming>Flow_QTHematologico</bpmn:incoming>
      <bpmn:outgoing>Flow_QTHematoToTratamiento</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_QTHematologico" name="QT Cáncer Hematológico (Adulto o Niño)" sourceRef="Gateway_Tratamiento" targetRef="Task_ProgramarQTHemato" />
    <bpmn:userTask id="Task_PacienteEnTratamientoFricke" name="Paciente en tratamiento continuo y seguimiento en Hospital Fricke">
      <bpmn:documentation>El paciente recibe tratamiento de quimioterapia hematológica o se encuentra en seguimiento post-cirugía dentro del Hospital Fricke, acompañado por el gestor oncológico.</bpmn:documentation>
      <bpmn:incoming>Flow_QTHematoToTratamiento</bpmn:incoming>
      <bpmn:incoming>Flow_ListaEsperaToSeguimiento</bpmn:incoming>
      <bpmn:incoming>Flow_PaliativosToSeguimiento</bpmn:incoming>
      <bpmn:outgoing>Flow_TratamientoToSeguimientoGestor</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_QTHematoToTratamiento" sourceRef="Task_ProgramarQTHemato" targetRef="Task_PacienteEnTratamientoFricke" />
    <bpmn:sequenceFlow id="Flow_ListaEsperaToSeguimiento" sourceRef="Task_PacienteListaEsperaQx" targetRef="Task_PacienteEnTratamientoFricke" />
    <bpmn:intermediateThrowEvent id="IntermediateThrow_DerivacionQTSolida" name="Derivar paciente a Hospital Van Buren (QT tumor sólido)">
      <bpmn:documentation>Los cánceres de tumores sólidos (adulto y niño) se derivan al Hospital Carlos Van Buren para quimioterapia. A partir de este punto, el Hospital Fricke pierde visibilidad del seguimiento del paciente.</bpmn:documentation>
      <bpmn:incoming>Flow_QTSolido</bpmn:incoming>
      <bpmn:outgoing>Flow_QTSolidoToFin</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_QTSolida" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="Flow_QTSolido" name="QT Cáncer Órgano Sólido (Adulto o Niño)" sourceRef="Gateway_Tratamiento" targetRef="IntermediateThrow_DerivacionQTSolida" />
    <bpmn:intermediateThrowEvent id="IntermediateThrow_DerivacionRadio" name="Derivar paciente a Hospital Van Buren (Radioterapia)">
      <bpmn:documentation>Todas las radioterapias se derivan al Hospital Carlos Van Buren. El Hospital Fricke pierde visibilidad del seguimiento del paciente.</bpmn:documentation>
      <bpmn:incoming>Flow_Radioterapia</bpmn:incoming>
      <bpmn:outgoing>Flow_RadioToFin</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Radio" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="Flow_Radioterapia" name="Radioterapia" sourceRef="Gateway_Tratamiento" targetRef="IntermediateThrow_DerivacionRadio" />
    <bpmn:userTask id="Task_DefinirCuidadosPaliativos" name="Derivar a cuidados paliativos (cáncer avanzado)">
      <bpmn:documentation>Hay pacientes cuyo cáncer está tan avanzado que pasan a comité oncológico pero se les asignan cuidados paliativos. Continúan siendo acompañados por el gestor.</bpmn:documentation>
      <bpmn:incoming>Flow_Paliativos</bpmn:incoming>
      <bpmn:outgoing>Flow_PaliativosToSeguimiento</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Paliativos" name="Cuidados Paliativos" sourceRef="Gateway_Tratamiento" targetRef="Task_DefinirCuidadosPaliativos" />
    <bpmn:sequenceFlow id="Flow_PaliativosToSeguimiento" sourceRef="Task_DefinirCuidadosPaliativos" targetRef="Task_PacienteEnTratamientoFricke" />
    <bpmn:userTask id="Task_DerivarDuplaPsicosocial" name="Derivar a dupla psicosocial (psicólogo, psicooncólogo, asistente social)">
      <bpmn:documentation>El gestor deriva al paciente a la dupla psicosocial según sus necesidades: asistencia psicológica (psicooncología) y asistente social para asesorar en programas de ayuda, nexo con municipalidad o APS para sostén económico.</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:userTask id="Task_DerivarNutricion" name="Derivar a nutrición oncológica">
      <bpmn:documentation>El gestor realiza nexo con nutrición oncológica dependiendo del tipo de cáncer y las necesidades nutricionales del paciente.</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_SolicitarCompraServicio" name="Solicitar compra de servicio externo (PET-CT, EBUS, Ablación)">
      <bpmn:documentation>Cuando el paciente requiere un procedimiento que no está en la cartera de servicios del Hospital Fricke (como PET-CT, EBUS, ablación hepática), el gestor gestiona la compra de servicio o alianza estratégica con centros privados o de la red hospitalaria (Hospital del Tórax, San Borja Arriarán, clínicas en Santiago o V Región, OncoCenter, etc.).</bpmn:documentation>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_RecibirResultadosExternos" name="Recibir resultados de exámenes externos (centros privados)">
      <bpmn:documentation>El gestor recibe los resultados de los exámenes o procedimientos realizados en centros externos contratados.</bpmn:documentation>
    </bpmn:receiveTask>
    <bpmn:userTask id="Task_SeguimientoGestor" name="Seguimiento continuo del paciente por gestor oncológico">
      <bpmn:documentation>El gestor oncológico realiza seguimiento continuo del paciente a lo largo de toda su trayectoria oncológica: verifica en qué va, gestiona nuevos exámenes, coordina con especialidades y resuelve dudas del paciente y familia. El gestor indica que falta tiempo para esta labor debido a la alta demanda espontánea. Se están evaluando alternativas como chatbot y tótems.</bpmn:documentation>
      <bpmn:incoming>Flow_TratamientoToSeguimientoGestor</bpmn:incoming>
      <bpmn:outgoing>Flow_SeguimientoToFin2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_TratamientoToSeguimientoGestor" sourceRef="Task_PacienteEnTratamientoFricke" targetRef="Task_SeguimientoGestor" />
    <bpmn:endEvent id="End_DerivadoExterno" name="Paciente derivado a centro externo – Pérdida de visibilidad del seguimiento en Fricke">
      <bpmn:documentation>El paciente es derivado al Hospital Van Buren o a centros privados. El Hospital Fricke pierde visibilidad y no tiene información de lo que sucede con el paciente tras la derivación.</bpmn:documentation>
      <bpmn:incoming>Flow_QTSolidoToFin</bpmn:incoming>
      <bpmn:incoming>Flow_RadioToFin</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_QTSolidoToFin" sourceRef="IntermediateThrow_DerivacionQTSolida" targetRef="End_DerivadoExterno" />
    <bpmn:sequenceFlow id="Flow_RadioToFin" sourceRef="IntermediateThrow_DerivacionRadio" targetRef="End_DerivadoExterno" />
    <bpmn:endEvent id="End_TratamientoFricke" name="Paciente en tratamiento continuo y seguimiento en Hospital Fricke (acompañado por gestor oncológico)">
      <bpmn:documentation>El paciente permanece dentro del Hospital Fricke en tratamiento (QT hematológica, post-cirugía o cuidados paliativos) y es acompañado de forma continua por el gestor oncológico según lo establece la Ley del Cáncer.</bpmn:documentation>
      <bpmn:incoming>Flow_SeguimientoToFin2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_SeguimientoToFin2" sourceRef="Task_SeguimientoGestor" targetRef="End_TratamientoFricke" />
    <bpmn:startEvent id="Start_DerivacionConsulta" name="Derivación directa desde consulta médica de especialidades">
      <bpmn:documentation>El paciente es derivado directamente desde una consulta médica en el CAE. El médico puede tener sospecha o confirmación de cáncer y lo deriva con indicaciones al servicio de gestión oncológica.</bpmn:documentation>
      <bpmn:outgoing>Flow_InicioConsulta</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_DerivacionComite" name="Derivación desde Comité Oncológico">
      <bpmn:documentation>El paciente ha sido presentado en el comité oncológico y de ahí salen las acciones a realizar para su objetivo terapéutico.</bpmn:documentation>
      <bpmn:outgoing>Flow_InicioComite</bpmn:outgoing>
    </bpmn:startEvent>
  </bpmn:process>
