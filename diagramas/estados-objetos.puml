skinparam stateFontSize 16
skinparam stateArrowFontSize 13
skinparam legendBackgroundColor #EDF3FA
skinparam legendBorderColor #B7C9DD
skinparam legendFontColor #172A40
skinparam state {
  BackgroundColor #EAF1F8
  BorderColor #526B87
  FontColor #172A40
  ArrowColor #425B78
  StartColor #526B87
  EndColor #526B87
}

title EST-02 · Seguimiento de una derivación externa

state "Dossier Confeccionado" as C
state "Despachado por UGAA" as D
state "Recepcionado en HCVB" as R
state "Cita Asignada" as A
state "Tratamiento Iniciado" as T
state "Contrarreferido con Epicrisis" as E #E7F4EC

[*] -down-> C : / Reunir antecedentes y dejar\n  disponible para validación
C -down-> D : Formalizar despacho\n[dossier validado, constancia de entrega,\nfecha y folio informados]\n/ Registrar despacho y asociar constancia
D -down-> R : Confirmar recepción\n[acuse de HCVB]\n/ Guardar recepción
D --> D : Al cumplirse 11 días hábiles\n[sin recepción ni fecha de atención]\n/ Generar y notificar alerta
R -right-> A : Fecha confirmada\n[por HCVB]\n/ Vincular fecha
A -up-> T : Registrar inicio de tratamiento\n[inicio acreditado]\n/ Registrar hito
T -up-> E : Registrar retorno al HGF\n[atención finalizada, epicrisis\n y contrarreferencia disponibles]\n/ Vincular documentos, registrar\n  hito y notificar a la gestora
E -up-> [*]

legend top
  **Creación.** TENS solicita el dossier con los antecedentes
  y la resolución firmada de derivación disponibles.
endlegend
@enduml


@startuml EST-03-CasoOncologico
!pragma layout smetana
hide empty description
skinparam shadowing false
skinparam dpi 144
skinparam backgroundColor #F7F9FC
skinparam defaultFontName SansSerif
skinparam titleFontSize 18
skinparam titleFontColor #172A40
skinparam stateFontSize 16
skinparam stateArrowFontSize 13
skinparam legendBackgroundColor #EDF3FA
skinparam legendBorderColor #B7C9DD
skinparam legendFontColor #172A40
skinparam state {
  BackgroundColor #EAF1F8
  BorderColor #526B87
  FontColor #172A40
  ArrowColor #425B78
  StartColor #526B87
  EndColor #526B87
}

title EST-03 · Ciclo de vida de CasoOncologico (Etapas asistenciales)

state "Sospecha" as S
state "Confirmación diagnóstica" as CD
state "Etapificación" as E
state "Tratamiento" as T
state "Rehabilitación" as R
state "Cuidados paliativos y alivio del dolor" as CP
state "Seguimiento y sobrevivientes" as SS
state "Alta y contrarreferencia" as AC #E7F4EC

[*] -down-> S : / Ingreso del caso por sospecha\n  o hallazgo clínico
S -down-> CD : Confirmación diagnóstica\n[diagnóstico histopatológico o clínico]\n/ Emisión IPD si aplica
CD -down-> E : Indicación de etapificación\n/ Solicitud de estudios diagnósticos
E --> E : Resolución firmada de comité\n[sin evento clínico de inicio]\n/ Registrar hito en etapificación
E -down-> T : Inicio del tratamiento registrado\n[resolución de comité registrada]\n/ Registrar hito y cambio de etapa
T -down-> R : Finalización de terapia activa\n/ Derivación a rehabilitación
T -right-> CP : Indicación médica de soporte\n/ Ingreso a cuidados paliativos
R -down-> SS : Controles periódicos\n/ Vigilancia activa de sobreviviente
CP -down-> AC : Cierre asistencial documentado\n/ Registro de egreso del caso
SS -down-> AC : Cumplimiento de vigilancia o remisión\n/ Contrarreferencia formal a APS
AC -down-> [*]

legend top
  **Trayectoria oncológica de 8 etapas (HU-01).**
  La resolución de comité se incorpora como hito de Etapificación (HU-01-ESC-03)
  y el cambio a Tratamiento requiere registrar el inicio efectivo (HU-01-ESC-02).
endlegend
@enduml

