}

class RegistroREM7 {
  periodoMes: Texto
  seccion: Texto
  codigoPrestacion: Texto
  totalCasos: Entero
}

class InteraccionCanalUsuario {
  identificadorSesion: Texto
  canal: Texto
  runUsuario: Texto
  fechaHora: FechaHora
  tipoConsulta: Texto
}

class TicketTriagePresencial {
  numeroTurno: Texto
  nivelPrioridad: Texto
  motivoConsulta: Texto
  fechaEmision: FechaHora
  estadoAtencion: Texto
}

class RegistroIntercambioMINSAL {
  identificadorMensaje: Texto
  tipoEvento: Texto
  fechaEnvio: FechaHora
  estadoSincronizacion: Texto
  codigoRespuesta: Texto
  folioTransaccionMINSAL: Texto
}

CasoOncologico "1" -- "0..*" EvaluacionMultidimensional : registra
EvaluacionMultidimensional "1" -- "1..*" DominioValoracion : evalúa
CasoOncologico "1" -- "0..*" EntradaBitacora : documenta
CasoOncologico "1" -- "0..*" FichaPresentacionComite : sustenta
FichaPresentacionComite "1" -- "0..1" ActaComite : presenta a
ActaComite "1" -- "1..*" FirmaElectronica : suscribe con
ActaComite "0..*" -- "1" RegistroREM7 : tributa a
CasoOncologico "1" -- "0..*" InteraccionCanalUsuario : consulta en
InteraccionCanalUsuario "0..1" -- "0..1" TicketTriagePresencial : emite
CasoOncologico "1" -- "0..*" RegistroIntercambioMINSAL : reporta a

@enduml
