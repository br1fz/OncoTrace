@startuml vista-valoracion-comites-canales
!pragma layout smetana
hide methods
hide circle
skinparam backgroundColor white
skinparam shadowing false
skinparam classBackgroundColor #F8FAFC
skinparam classBorderColor #334155
skinparam classFontColor #0F172A
skinparam classAttributeFontColor #334155
skinparam classFontSize 19
skinparam classAttributeFontSize 16
skinparam ArrowColor #475569
skinparam ArrowFontSize 15
skinparam titleFontSize 23
skinparam titleFontColor #0F172A
skinparam defaultFontName SansSerif
top to bottom direction

title
MD-01.D — Valoración integral, bitácora, comités, canales y MINSAL
end title

class CasoOncologico {
  numeroCaso: Texto
  especialidad: Texto
  codigoDiagnosticoOSospecha: Texto
  etapaActual: EtapaTrayectoria
}

class EvaluacionMultidimensional {
  identificador: Texto
  fechaEvaluacion: FechaHora
  puntajeClinicoFuncional: Entero
  puntajePsicoemocional: Entero
  escalaZaritCuidador: Entero
  nivelVulnerabilidad: Texto
  profesionalEvaluador: Texto
}

class DominioValoracion {
  tipoDominio: Texto
  descripcionHallazgo: Texto
  requiereDerivacion: Booleano
  especialidadDerivada: Texto
}

class EntradaBitacora {
  identificador: Texto
  puntoContactoNormado: Texto
  fechaContacto: FechaHora
  canalContacto: Texto
  resumenInteraccion: Texto
  acuerdosEstablecidos: Texto
  responsableRegistro: Texto
  estadoContacto: Texto
}

class FichaPresentacionComite {
  folioFicha: Texto
  resumenClinico: Texto
  etapificacionTNM: Texto
  biopsiaValidadaReferencia: Texto
  propuestaConducta: Texto
  fechaGeneracion: FechaHora
}

class ActaComite {
  numeroActa: Texto
  fechaSesion: FechaHora
  quorumAsistentes: Texto
  resolucionAcordada: Texto
  estadoFirma: Texto
}

class FirmaElectronica {
  runFirmante: Texto
  nombreFirmante: Texto
  rolFirmante: Texto
